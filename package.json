    "firebase": "13.4.0",
    "firebase-admin": "13.10.0",
    "idb": "8.0.3",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "serwist": "9.5.13",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
