# Copie para .env.local e preencha. Confira com `npm run env:check` (mostra só nomes, nunca valores).
# Guia completo: docs/setup/configuracao.md

# --- Catálogo (obrigatório) ---
# Token de leitura da API do TMDb (v4, "API Read Access Token"), enviado como Bearer.
TMDB_READ_TOKEN=
# Endereço público do site: links canônicos, sitemap, robots e imagem de compartilhamento.
# Em produção: https://telaviva.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Contas (opcional: sem elas o site funciona só como visitante; ou todas, ou nenhuma) ---
# Configuração pública do app web do Firebase (vai para o navegador).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Host do próprio site, sem https:// (proxy /__/auth). Localmente, localhost vira <projeto>.firebaseapp.com sozinho.
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost:3000
# Conta de serviço do Firebase (segredo do servidor; nunca com prefixo NEXT_PUBLIC_).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# O private_key do JSON, numa linha só, com os \n literais.
FIREBASE_PRIVATE_KEY=
# Postgres do Neon (criado pela integração da Vercel).
DATABASE_URL=

# --- Só para desenvolvimento local e testes; nunca na Vercel ---
# Emulador do Firebase Auth (`npm run emulators`, porta 9099).
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
# PGlite (Postgres no processo) no lugar do Neon; a pasta guarda o banco (sem ela, fica só na memória).
# DATABASE_DRIVER=pglite
# PGLITE_DIR=.e2e/pglite-local

# --- Opcionais ---
# Outra base para a API do TMDb (o E2E aponta para um mock local).
# TMDB_API_BASE_URL=https://api.themoviedb.org/3
# Limite de cada pedido ao TMDb, em milissegundos (1000 a 120000; padrão 8000).
# TMDB_TIMEOUT_MS=8000
# Botão de emergência: 1 desliga o service worker (o site remove o que estiver instalado).
# NEXT_PUBLIC_SW_DISABLED=1
